# thesis_auto_generator — 环境变量示例（复制为 .env 并填写）

# ---- LLM（config.py 按 LLM_PROVIDER 选择对应的 KEY/BASE 变量名）----
LLM_PROVIDER=
LLM_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
OPENAI_API_KEY=

# ---- 异步任务（可选，不用 Celery 可留空）----
ASYNC_MODE=
CELERY_BROKER_URL=
REDIS_URL=

# ---- 生成与文献 ----
MAX_TOKENS_PER_CHAPTER=
SEMANTIC_SCHOLAR_API_KEY=
